@startuml ClassDiagram_GestionaleMagazzino

skinparam class {
  BackgroundColor #FAFAFA
  BorderColor     #333333
  ArrowColor      #555555
}
skinparam classAttributeIconSize 0
hide methods
hide circle

' ── NOTA: primo Class Diagram orientato al dominio.
'    Attributi tipizzati, visibilità, enum. Nessun metodo, nessuna classe tecnica
'    (Repository, DAO, Controller, helper) come da prassi del corso.

' ── ENUMERAZIONI ────────────────────────────────────

enum Ruolo {
  MAGAZZINIERE
  CONTABILE
  AMMINISTRATORE
}

enum StatoOrdineEntrata {
  BOZZA
  IN_APPROVAZIONE
  APPROVATO
  RICEVUTO
  ANNULLATO
}

enum StatoOrdineUscita {
  BOZZA
  CONFERMATO
  EVASO
  ANNULLATO
}

' ── CLASSI ──────────────────────────────────────────

class Utente {
  - id           : int
  - username     : String
  - passwordHash : String
  - nome         : String
  - cognome      : String
  - ruolo        : Ruolo
}

class Categoria {
  - id          : int
  - codice      : String
  - nome        : String
  - descrizione : String
}

class Prodotto {
  - id             : int
  - codice         : String
  - nome           : String
  - descrizione    : String
  - unitàMisura    : String
  - prezzoUnitario : double
}

class Giacenza {
  - id                   : int
  - quantitàDisponibile  : int
}

class OrdineEntrata {
  - id     : int
  - numero : String
  - data   : LocalDate
  - stato  : StatoOrdineEntrata
  - note   : String
}

class OrdineUscita {
  - id     : int
  - numero : String
  - data   : LocalDate
  - stato  : StatoOrdineUscita
  - note   : String
}

class RigaOrdineEntrata {
  - id             : int
  - quantità       : int
  - prezzoUnitario : double
}

class RigaOrdineUscita {
  - id       : int
  - quantità : int
}

class DDT {
  - id     : int
  - numero : String
  - data   : LocalDate
  - note   : String
}

' ── RELAZIONI ───────────────────────────────────────

Prodotto          "0..*" -->  "1"    Categoria            : appartiene a

' Composizione: la Giacenza dipende dall'esistenza del Prodotto
Prodotto          "1"    *--  "1"    Giacenza             : tiene traccia in

' Composizione: le righe non esistono senza l'ordine padre
OrdineEntrata     "1"    *--  "1..*" RigaOrdineEntrata    : contiene
OrdineUscita      "1"    *--  "1..*" RigaOrdineUscita     : contiene

RigaOrdineEntrata "1..*" -->  "1"    Prodotto             : riguarda
RigaOrdineUscita  "1..*" -->  "1"    Prodotto             : riguarda

' Un ordine di uscita può generare al più un DDT
OrdineUscita      "1"    -->  "0..1" DDT                  : genera

Utente            "1"    -->  "0..*" OrdineEntrata         : registra
Utente            "1"    -->  "0..*" OrdineUscita          : registra

@enduml
