@startuml DomainModel_GestionaleMagazzino

skinparam class {
  BackgroundColor #e9bd2e
  BorderColor     #333333
  ArrowColor      #555555
}
skinparam classAttributeIconSize 0
hide methods
hide circle

class Utente {
  username
  nome
  cognome
  ruolo
}

class Categoria {
  codice
  nome
  descrizione
}

class Prodotto {
  codice
  nome
  descrizione
  unitàMisura
  prezzoUnitario
}

class Giacenza {
  quantitàDisponibile
}

class OrdineEntrata {
  numero
  data
  stato
  note
  quantità
  prezzoUnitario
}

class OrdineUscita {
  numero
  data
  stato
  note
  quantità
}

class DDT {
  numero
  data
  note
}

' ── ASSOCIAZIONI ────────────────────────────────────

' Un prodotto appartiene a una categoria
Prodotto       "0..*" -- "1"    Categoria          : appartiene a

' La giacenza traccia lo stock corrente di un prodotto
Giacenza       "1"    --  "1"    Prodotto            : traccia stock di

' Gli ordini contengono righe (composizione: le righe non esistono senza l'ordine)
OrdineEntrata  "1"    -- "1..*" OrdineEntrata   : contiene
OrdineUscita   "1"    -- "1..*" OrdineUscita    : contiene

' Ogni riga riguarda un prodotto
OrdineEntrata "1..*" -- "1" Prodotto            : riguarda
OrdineUscita  "1..*" -- "1" Prodotto            : riguarda

' Un ordine di uscita può generare un DDT
OrdineUscita   "1"    -- "0..1" DDT                 : genera

' Un utente registra ordini
Utente         "1"    -- "0..*" OrdineEntrata        : registra
Utente         "1"    -- "0..*" OrdineUscita         : registra

@enduml
