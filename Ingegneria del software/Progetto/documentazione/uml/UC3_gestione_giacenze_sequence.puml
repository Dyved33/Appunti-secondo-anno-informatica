@startuml UC3_GestioneGiacenze_SD

skinparam sequence {
  ArrowColor      #555555
  ParticipantBackgroundColor #FAFAFA
  ParticipantBorderColor #333333
  ActorBackgroundColor #E8F4FD
  ActorBorderColor #2980B9
}

actor    "Magazziniere"          as Mag
boundary "ui:UI"                 as UI
control  "svc:OrdineService"     as OrdSvc
control  "svc:GiacenzaService"   as InvSvc

' ── 1. Aggiungere Merci (Ordine Entrata) ─────────────
group Aggiungere Merci
  Mag -> UI : nuovoOrdineEntrata()
  activate UI
  UI -> OrdSvc : creaOrdineEntrata()
  activate OrdSvc
  OrdSvc --> UI : ordineCreato
  deactivate OrdSvc

  loop [per ogni prodotto da aggiungere]
    Mag -> UI : aggiungiRiga(prodotto, quantità)
    UI -> OrdSvc : aggiungiRiga(ordine, prodotto, quantità)
    activate OrdSvc
    OrdSvc --> UI : rigaAggiunta
    deactivate OrdSvc
  end

  Mag -> UI : confermaOrdine()
  UI -> OrdSvc : confermaOrdineEntrata(ordine)
  activate OrdSvc
  OrdSvc -> InvSvc : aggiornaGiacenze(ordine.righe)
  activate InvSvc
  InvSvc --> OrdSvc : giacenzeAggiornate
  deactivate InvSvc
  OrdSvc --> UI : ordineConfermato
  deactivate OrdSvc
  UI --> Mag : mostraConferma()
  deactivate UI
end

' ── 2. Visualizzare Giacenze ─────────────────────────
group Visualizzare Giacenze
  Mag -> UI : apriGiacenze()
  activate UI
  UI -> InvSvc : getGiacenze()
  activate InvSvc
  InvSvc --> UI : listaGiacenze
  deactivate InvSvc
  UI --> Mag : mostraElencoGiacenze(listaGiacenze)
  deactivate UI
end

' ── 3. Stampare Inventario ───────────────────────────
group Stampare Inventario
  Mag -> UI : stampaInventario()
  activate UI
  UI -> InvSvc : generaReportInventario()
  activate InvSvc
  InvSvc --> UI : reportPDF
  deactivate InvSvc
  UI --> Mag : apriDocumentoDiStampa(reportPDF)
  deactivate UI
end

@enduml

