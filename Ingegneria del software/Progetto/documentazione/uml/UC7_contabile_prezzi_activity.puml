@startuml UC7_ContabilePrezzi_AD

skinparam activity {
  BackgroundColor #FAFAFA
  BorderColor #333333
  ArrowColor #555555
  DiamondBackgroundColor #FFF9E6
  DiamondBorderColor #B8860B
}

|Contabile|
start
:Sceglie operazione;

if (Aggiornare Prezzi?) then (sì)
  :Apre lista prodotti;

  |Sistema|
  :Carica e mostra prodotti con prezzi attuali;

  |Contabile|
  :Seleziona un prodotto;
  :Inserisce nuovo prezzo unitario\n(al pezzo o al chilo);

  |Sistema|
  :Aggiorna prezzoUnitario del prodotto;

  |Contabile|
  :Visualizza conferma aggiornamento;

else (no — Visualizzare Valore Magazzino)
  |Sistema|
  :Calcola totale quantità e valore\n(Σ quantità × prezzoUnitario);
  :Mostra riepilogo magazzino;
endif

stop

@enduml

