@startuml UC3_GestioneGiacenze_AD

skinparam activity {
  BackgroundColor #FAFAFA
  BorderColor #333333
  ArrowColor #555555
  DiamondBackgroundColor #FFF9E6
  DiamondBorderColor #B8860B
}

|Magazziniere|
start
:Sceglie operazione sulle giacenze;

if (Aggiungere Merci?) then (sì)
  :Crea nuovo Ordine Entrata;

  repeat
    :Aggiunge riga (prodotto, quantità);
  repeat while (altri prodotti?) is (sì)
  ->no;

  :Conferma ordine;

  |Sistema|
  :Aggiorna giacenze per ogni riga;
  :Imposta stato OrdineEntrata = RICEVUTO;

  |Magazziniere|
  :Visualizza conferma;

else (no)
  if (Visualizzare Giacenze?) then (sì)
    |Sistema|
    :Carica e mostra elenco giacenze;

  else (no — Stampare Inventario)
    |Sistema|
    :Genera report inventario (PDF);

    |Magazziniere|
    :Visualizza e stampa documento;
  endif
endif

stop

@enduml

