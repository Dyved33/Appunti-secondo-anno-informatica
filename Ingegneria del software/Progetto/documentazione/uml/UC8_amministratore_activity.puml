@startuml UC8_Admin_AD

skinparam activity {
  BackgroundColor #FAFAFA
  BorderColor #333333
  ArrowColor #555555
  DiamondBackgroundColor #FFF9E6
  DiamondBorderColor #B8860B
}

|Admin|
start
:Sceglie sezione da gestire;

if (Merci?) then (sì)
  |Sistema|
  :Carica e mostra merci con valore totale;

  |Admin|
  if (vuole agire su un prodotto?) then (sì)
    :Seleziona prodotto;

    if (Modifica?) then (sì)
      :Inserisce nuovi dati;

      |Sistema|
      :Aggiorna prodotto;

    else (no — Elimina)
      |Sistema|
      :Elimina prodotto;
    endif

    |Admin|
    :Visualizza conferma;
  endif

else (no)
  if (Fatture?) then (sì)
    |Sistema|
    :Carica e mostra elenco fatture;

    |Admin|
    if (vuole agire su una fattura?) then (sì)
      :Seleziona fattura;

      if (Annulla?) then (sì)
        |Sistema|
        :Imposta stato Fattura = ANNULLATA;

      else (no — Elimina)
        |Sistema|
        :Elimina fattura;
      endif

      |Admin|
      :Visualizza conferma;
    endif

  else (no — Resi)
    |Sistema|
    :Carica e mostra elenco resi;

    |Admin|
    :Seleziona un reso;

    if (Approva?) then (sì)
      |Sistema|
      :Imposta stato Reso = APPROVATO;

    else (no — Rifiuta)
      |Sistema|
      :Imposta stato Reso = RIFIUTATO;
    endif

    |Admin|
    :Visualizza conferma;
  endif
endif

stop

@enduml

