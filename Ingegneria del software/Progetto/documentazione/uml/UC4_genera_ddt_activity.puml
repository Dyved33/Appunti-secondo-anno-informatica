@startuml UC4_GeneraDDT_AD

skinparam activity {
  BackgroundColor #FAFAFA
  BorderColor #333333
  ArrowColor #555555
  DiamondBackgroundColor #FFF9E6
  DiamondBorderColor #B8860B
}

|Magazziniere|
start
:Apre elenco ordini uscita non evasi;

|Sistema|
:Carica e mostra ordini con stato NON_EVASO;

|Magazziniere|
:Seleziona un ordine;
:Visualizza dettaglio ordine;
:Richiede generazione DDT;

|Sistema|
:Genera documento DDT;
:Imposta stato OrdineUscita = EVASO;

|Magazziniere|
:Visualizza DDT generato;

stop

@enduml
