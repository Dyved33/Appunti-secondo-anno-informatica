@startuml ClassDiagram
hide circle
hide methods
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FAFAFA
  BorderColor #333333
  ArrowColor #555555
}
skinparam enum {
  BackgroundColor #FAFAFA
  BorderColor #333333
}
title Class diagram del dominio e delle dipendenze principali
enum Ruolo {
  magazziniere
  contabile
  admin
}
enum StatoOrdine {
  confermato
  evaso
  annullato
}
enum TipoFattura {
  fattura
  nota_credito
}
enum StatoReso {
  da_verificare
  accettato
  rifiutato
}
class Utente {
  id : int
  username : string
  passwordHash : string
  ruolo : Ruolo
  tentativiFalliti : int
  bloccato : bool
  createdAt : time
}
class Sessione {
  id : int
  userID : int
  tokenHash : string
  expiresAt : time
  createdAt : time
}
class Categoria {
  id : int
  nome : string
  descrizione : string
}
class Prodotto {
  id : int
  codice : string
  barcode : string
  nome : string
  descrizione : string
  categoriaID : int
  prezzoAcq : float64
  prezzoVend : float64
  sogliaMin : int
}
class Giacenza {
  id : int
  prodottoID : int
  quantita : int
  updatedAt : time
}
class OrdineEntrata {
  id : int
  ddtID : int
  numero : string
  fornitore : string
  data : time
  note : string
  createdBy : int
}
class RigaOrdineEntrata {
  id : int
  ordineEntrataID : int
  prodottoID : int
  quantita : int
  prezzoUnitario : float64
}
class OrdineUscita {
  id : int
  numero : string
  cliente : string
  data : time
  stato : StatoOrdine
  note : string
  createdBy : int
  ddtID : int?
}
class RigaOrdineUscita {
  id : int
  ordineUscitaID : int
  prodottoID : int
  quantita : int
  prezzoUnitario : float64
}
class DDT {
  id : int
  numero : string
  ordineUscitaID : int
  data : time
  mittente : string
  destinatario : string
  pathPDF : string
}
class Fattura {
  id : int
  numero : string
  anno : int
  tipo : TipoFattura
  ordineUscitaID : int
  imponibile : float64
  iva : float64
  totale : float64
  data : time
  pathPDF : string
}
class Reso {
  id : int
  ordineUscitaID : int
  prodottoID : int
  quantita : int
  motivo : string
  stato : StatoReso
  data : time
  createdBy : int
}
Utente "1" -- "0..*" Sessione
Utente "1" -- "0..*" OrdineEntrata : registra
Utente "1" -- "0..*" OrdineUscita : registra
Categoria "0..1" -- "0..*" Prodotto : categorizza
Prodotto "1" *-- "1" Giacenza
OrdineEntrata "1" *-- "0..*" RigaOrdineEntrata
OrdineUscita "1" *-- "0..*" RigaOrdineUscita
RigaOrdineEntrata "*" --> "1" Prodotto
RigaOrdineUscita "*" --> "1" Prodotto
OrdineUscita "1" -- "0..1" DDT : genera
OrdineUscita "1" -- "0..*" Fattura
OrdineUscita "1" -- "0..*" Reso
Reso "*" --> "1" Prodotto
@enduml
