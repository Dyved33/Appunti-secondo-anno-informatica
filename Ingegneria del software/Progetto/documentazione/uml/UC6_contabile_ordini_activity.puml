@startuml UC6_ContabileOrdini_AD

skinparam activity {
  BackgroundColor #FAFAFA
  BorderColor #333333
  ArrowColor #555555
  DiamondBackgroundColor #FFF9E6
  DiamondBorderColor #B8860B
}

|Contabile|
start
:Apre sezione Ordini Uscita;

|Sistema|
:Carica e mostra elenco ordini uscita;

|Contabile|
if (vuole filtrare per stato?) then (sì)
  :Seleziona filtro (Evaso / Non Evaso);

  |Sistema|
  :Mostra elenco filtrato;
endif

|Contabile|
:Seleziona un ordine;

|Sistema|
:Mostra dettaglio ordine con righe;

|Contabile|
if (vuole generare fattura?) then (sì)

  |Sistema|
  if (ordine è EVASO?) then (sì)
    :Genera documento Fattura;

    |Contabile|
    :Visualizza fattura generata;

  else (no)
    :Mostra errore "Ordine non evaso";
  endif

endif

|Contabile|
if (vuole generare nota di credito?) then (sì)

  |Sistema|
  if (ordine è EVASO?) then (sì)
    :Genera documento Nota di Credito;

    |Contabile|
    :Visualizza nota di credito generata;

  else (no)
    :Mostra errore "Ordine non evaso";
  endif

endif

stop

@enduml

