@startuml UC1_SD

skinparam sequence {
  ArrowColor      #555555
  ParticipantBackgroundColor #FAFAFA
  ParticipantBorderColor #333333
  ActorBackgroundColor #E8F4FD
  ActorBorderColor #2980B9
}

actor    "Utente"          as User
actor    "Admin"  as Admin
boundary "ui:UI"           as UI
control  "svc:AuthService" as Auth

' ── FLUSSO PRINCIPALE: Login ─────────────────────────────────────
group Login
  User -> UI : inserisciCredenziali(username, password)
  activate UI
  UI -> Auth : login(username, password)
  activate Auth
  Auth -> Auth : verificaCredenziali(username, password)

  alt [credenziali valide]
    Auth --> UI : loginOK(ruolo)
    UI --> User : mostraHomePage()
  else [credenziali non valide]
    Auth -> Auth : incrementaTentativiFalliti()
    alt [tentativiFalliti >= 3]
      Auth --> UI : errore("Account bloccato")
      UI --> User : mostraMessaggioBloccato()
    else [tentativiFalliti < 3]
      Auth --> UI : errore("Credenziali non valide")
      UI --> User : mostraErroreLogin()
    end
  end
  deactivate Auth
  deactivate UI
end

' ── FLUSSO ALTERNATIVO: Recupero Credenziali ─────────────────────
group Recupero Credenziali
  User -> Admin : segnalaCredenzialiPerdute()
  activate Admin
  Admin -> UI : cercaUtente(username)
  activate UI
  UI -> Auth : getUtente(username)
  activate Auth
  Auth --> UI : utente(bloccato, tentativiFalliti)
  UI --> Admin : mostraDettagliUtente()

  alt [account bloccato]
    Admin -> UI : sbloccaUtente(username)
    UI -> Auth : aggiornaStato(username, bloccato = false)
    Auth --> UI : utenteSbloccato()
  end

  Admin -> UI : resettaPassword(username, nuovaPassword)
  UI -> Auth : aggiornaPassword(username, nuovaPassword)
  Auth --> UI : passwordAggiornata()
  UI --> Admin : mostraConfermaAggiornamento()
  Admin --> User : comunicaNuoveCredenziali()
  deactivate Auth
  deactivate UI
  deactivate Admin
end

@enduml

