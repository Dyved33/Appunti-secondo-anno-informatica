@startuml UC1_AD

skinparam activity {
  BackgroundColor #FAFAFA
  BorderColor #333333
  ArrowColor #555555
  DiamondBackgroundColor #FFF9E6
  DiamondBorderColor #B8860B
}

|Utente|
start
:Inserisce username e password;

|Sistema|
:Verifica credenziali;

if (credenziali valide?) then (sì)
  :Apre applicazione con ruolo utente;

else (no)
  :Incrementa contatore tentativi;

  if (tentativiFalliti >= 3?) then (sì)
    :Blocca account;
    |Utente|
    :Visualizza messaggio account bloccato;

  else (no)
    |Utente|
    :Visualizza errore credenziali;

    if (credenziali definitamente perdute?) then (sì)
      |Utente|
      :Si rivolge all'admin;

      |Admin|
      :Cerca l'utente;

      if (account bloccato?) then (sì)
        |Admin|
        :Sblocca l'account;
      endif

      |Admin|
      :Imposta una nuova password;

      |Sistema|
      :Aggiorna password e azzera tentativi;

      |Admin|
      :Comunica le nuove credenziali all'utente;

    endif
  endif
endif

stop

@enduml

