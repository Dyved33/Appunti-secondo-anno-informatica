@startuml UC1_Login_AD

skinparam activity {
  BackgroundColor #FAFAFA
  BorderColor #333333
  ArrowColor #555555
  DiamondBackgroundColor #FFF9E6
  DiamondBorderColor #B8860B
}

|Utente|
start
:Inserisce username e password;

|Sistema|
:Verifica credenziali;

if (credenziali valide?) then (sì)
  :Apre applicazione con ruolo utente;

else (no)
  :Incrementa contatore tentativi;

  if (tentativiFalliti >= 3?) then (sì)
    :Blocca account;
    |Utente|
    :Visualizza messaggio account bloccato;

  else (no)
    |Utente|
    :Visualizza errore credenziali;

    if (vuole recuperare la password?) then (sì)
      :Inserisce username;

      |Sistema|
      :Mostra domanda di sicurezza;

      |Utente|
      :Risponde alla domanda;

      |Sistema|
      if (risposta corretta?) then (sì)
        |Utente|
        :Imposta nuova password;

        |Sistema|
        :Aggiorna password e azzera tentativi;

        |Utente|
        :Visualizza conferma aggiornamento;

      else (no)
        |Sistema|
        :Mostra errore risposta non corretta;
      endif

    endif
  endif
endif

stop

@enduml
