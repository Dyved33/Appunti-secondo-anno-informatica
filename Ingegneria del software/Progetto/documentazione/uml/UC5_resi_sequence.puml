@startuml UC5_Resi_SD

skinparam sequence {
  ArrowColor      #555555
  ParticipantBackgroundColor #FAFAFA
  ParticipantBorderColor #333333
  ActorBackgroundColor #E8F4FD
  ActorBorderColor #2980B9
}

actor    "Contabile"             as Cont
actor    "Magazziniere"          as Mag
boundary "ui:UI"                 as UI
control  "svc:ResoService"       as ResoSvc
control  "svc:GiacenzaService"   as InvSvc

' ── 1. Contabile: registra il reso ───────────────────
group Registrazione Reso (Contabile)
  Cont -> UI : nuovoReso(ordineUscitaEvaso)
  activate UI
  UI -> ResoSvc : creaReso(ordineUscita)
  activate ResoSvc
  ResoSvc --> UI : resoCreato
  note right : stato = DA_VERIFICARE
  deactivate ResoSvc
  UI --> Cont : mostraConfermaCreazione()
  deactivate UI
end

' ── 2. Magazziniere: visualizza e verifica il reso ───
group Verifica Reso (Magazziniere)
  Mag -> UI : apriElencoResi()
  activate UI
  UI -> ResoSvc : getResi()
  activate ResoSvc
  ResoSvc --> UI : listaResi
  deactivate ResoSvc
  UI --> Mag : mostraElencoResi(listaResi)

  Mag -> UI : selezionaReso(reso)
  UI -> ResoSvc : getDettaglioReso(reso.id)
  activate ResoSvc
  ResoSvc --> UI : dettaglioReso
  deactivate ResoSvc
  UI --> Mag : mostraDettaglioReso(dettaglioReso)

  Mag -> UI : confermaVerificaFisica(reso)
  UI -> ResoSvc : verificaReso(reso.id)
  activate ResoSvc
  ResoSvc -> InvSvc : incrementaGiacenze(reso.righe)
  activate InvSvc
  InvSvc --> ResoSvc : giacenzeAggiornate
  deactivate InvSvc
  ResoSvc --> UI : resoVerificato
  note right : stato = VERIFICATO
  deactivate ResoSvc
  UI --> Mag : mostraConfermaVerifica()
  deactivate UI
end

@enduml
