@startuml UC9_GestioneUtenti_AD

skinparam activity {
  BackgroundColor #FAFAFA
  BorderColor #333333
  ArrowColor #555555
  DiamondBackgroundColor #FFF9E6
  DiamondBorderColor #B8860B
}

|Admin|
start
:Sceglie operazione sugli utenti;

if (Creare utente?) then (sì)
  :Inserisce dati utente\n(username, password, ruolo);

  |Sistema|
  :Valida e crea utente;

  |Admin|
  :Visualizza conferma;

else (no)
  if (Visualizzare utente?) then (sì)
    |Sistema|
    :Carica e mostra dettaglio utente;

  else (no)
    if (Modificare utente?) then (sì)
      |Admin|
      :Inserisce nuovi dati;

      |Sistema|
      :Aggiorna utente;

      |Admin|
      :Visualizza conferma;

    else (no — Eliminare)
      |Sistema|
      :Elimina utente;

      |Admin|
      :Visualizza conferma;
    endif
  endif
endif

stop

@enduml
