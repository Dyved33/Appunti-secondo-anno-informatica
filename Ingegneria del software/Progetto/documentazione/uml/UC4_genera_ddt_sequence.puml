@startuml UC4_GeneraDDT_SD

skinparam sequence {
  ArrowColor      #555555
  ParticipantBackgroundColor #FAFAFA
  ParticipantBorderColor #333333
  ActorBackgroundColor #E8F4FD
  ActorBorderColor #2980B9
}

actor    "Magazziniere"      as Mag
boundary "ui:UI"             as UI
control  "svc:OrdineService" as OrdSvc
control  "svc:DDTService"    as DDTSvc
entity   "ord:OrdineUscita"  as Ord

' ── Selezione ordine non evaso ───────────────────────
Mag -> UI : apriOrdiniNonEvasi()
activate UI
UI -> OrdSvc : getOrdiniUscitaNonEvasi()
activate OrdSvc
OrdSvc --> UI : listaOrdini
deactivate OrdSvc
UI --> Mag : mostraElencoOrdiniNonEvasi(listaOrdini)

Mag -> UI : selezionaOrdine(ordine)
UI --> Mag : mostraDettaglioOrdine(ordine)

' ── Generazione DDT e cambio stato ───────────────────
Mag -> UI : generaDDT()
UI -> DDTSvc : generaDDT(ordine)
activate DDTSvc

DDTSvc -> Ord : setStato(EVASO)

DDTSvc --> UI : ddt
deactivate DDTSvc

UI --> Mag : mostraDDT(ddt)
deactivate UI

@enduml

