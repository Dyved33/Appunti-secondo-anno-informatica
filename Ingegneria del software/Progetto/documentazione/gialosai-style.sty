% ============================================================
% gialosai-style.sty — Stile condiviso per la documentazione GiaLoSai
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{gialosai-style}[2026/08/25 v1.0 Stile documentazione GiaLoSai]

% --- Pacchetti base ---
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{babel}
\RequirePackage{geometry}
\RequirePackage{graphicx}
\RequirePackage[table]{xcolor}
\RequirePackage{hyperref}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{mdframed}
\RequirePackage{etoolbox}

% --- Geometria ---
\geometry{
  a4paper,
  top=3cm,
  bottom=3cm,
  left=2.8cm,
  right=2.8cm,
  headheight=14pt
}

% --- Colori ---
\definecolor{gialosaiBlue}{HTML}{1B3A5C}
\definecolor{gialosaiAccent}{HTML}{2E6DA4}
\definecolor{gialosaiGray}{HTML}{5A5A5A}
\definecolor{gialosaiLight}{HTML}{E8F0FE}
\definecolor{gialosaiBorder}{HTML}{B0C4DE}
\definecolor{gialosaiGreen}{HTML}{2E7D32}
\definecolor{gialosaiRed}{HTML}{C62828}

% --- Hyperref ---
\hypersetup{
  colorlinks=true,
  linkcolor=gialosaiBlue,
  urlcolor=gialosaiAccent,
  citecolor=gialosaiBlue,
  pdftitle={GiaLoSai},
  pdfauthor={Gruppo 11},
  bookmarks=true,
  bookmarksopen=true,
}

% --- Header / Footer ---
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\color{gialosaiGray}\textit{\leftmark}}
\fancyhead[R]{\small\color{gialosaiGray}GiaLoSai --- Gruppo 11}
\fancyfoot[C]{\small\color{gialosaiGray}\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[C]{\small\color{gialosaiGray}\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

% --- Formattazione sezioni ---
\titleformat{\section}
  {\Large\bfseries\color{gialosaiBlue}}
  {\thesection}{0.8em}{}
  [\vspace{-0.5em}{\color{gialosaiAccent}\rule{\textwidth}{1.5pt}}]

\titleformat{\subsection}
  {\large\bfseries\color{gialosaiAccent}}
  {\thesubsection}{0.6em}{}

\titleformat{\subsubsection}
  {\normalsize\bfseries\color{gialosaiBlue}}
  {\thesubsubsection}{0.5em}{}

\titlespacing*{\section}{0pt}{1.8em}{0.8em}
\titlespacing*{\subsection}{0pt}{1.2em}{0.6em}
\titlespacing*{\subsubsection}{0pt}{0.8em}{0.4em}

% --- Tabelle ---
\renewcommand{\arraystretch}{1.3}
\newcommand{\tableHeader}{\rowcolor{gialosaiBlue}\color{white}\bfseries}

% --- Elenchi ---
\setlist[itemize]{leftmargin=1.5em, itemsep=2pt, parsep=0pt}
\setlist[enumerate]{leftmargin=1.5em, itemsep=2pt, parsep=0pt}

% --- Note e box ---
\newmdenv[
  linecolor=gialosaiBorder,
  backgroundcolor=gialosaiLight,
  roundcorner=4pt,
  innertopmargin=10pt,
  innerbottommargin=10pt,
  innerleftmargin=12pt,
  innerrightmargin=12pt,
  skipabove=12pt,
  skipbelow=12pt
]{notebox}

\newmdenv[
  linecolor=gialosaiAccent,
  backgroundcolor=gialosaiLight,
  roundcorner=4pt,
  innertopmargin=10pt,
  innerbottommargin=10pt,
  innerleftmargin=12pt,
  innerrightmargin=12pt,
  skipabove=12pt,
  skipbelow=12pt
]{decisionbox}

% --- Title page ---
\newcommand{\gialosaiTitlePage}[3]{%
  \begin{titlepage}
    \centering
    \vspace*{1cm}

    % Linea superiore
    {\color{gialosaiAccent}\rule{\textwidth}{2pt}}

    \vspace{2cm}

    % Titolo
    {\Huge\bfseries\color{gialosaiBlue} #1\par}

    \vspace{0.8cm}

    % Sottotitolo / nome progetto
    {\Large\color{gialosaiAccent} \textsc{GiaLoSai}\par}

    \vspace{0.4cm}

    {\large\color{gialosaiGray} Gestione Logistica e Stoccaggio\par}

    \vspace{2cm}

    % Linea decorativa
    {\color{gialosaiBorder}\rule{0.6\textwidth}{0.8pt}}

    \vspace{2cm}

    % Info gruppo
    {\large\color{gialosaiGray}
      \textbf{Gruppo 11}\\[0.4em]
      Corso di Ingegneria del Software\\[0.2em]
      Anno Accademico 2025--2026
    \par}

    \vspace{1.5cm}

    % Data
    {\large\color{gialosaiGray} #2\par}

    \vspace{2cm}

    % Badge versione (opzionale)
    \ifstrempty{#3}{}{%
      {\small\color{gialosaiGray}
        \texttt{Versione #3}\par
      }
    }

    \vfill

    % Linea inferiore
    {\color{gialosaiAccent}\rule{\textwidth}{2pt}}

    \vspace{0.5cm}
    {\small\color{gialosaiGray} Universit\`{a} di Bologna --- Scuola di Ingegneria e Architettura}
  \end{titlepage}
}

% --- Comando per ringraziamenti / nota ---
\newcommand{\gialosaiNote}[1]{%
  \begin{notebox}
    \textbf{Nota:} #1
  \end{notebox}
}

% --- Comando per citazione di programmi CLI ---
\newcommand{\cliref}[2]{%
  \texttt{#1} (\url{#2})%
}

\endinput
